<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Routing Table</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/sidebar') %>
        <h1>Routing Table</h1>
        <button id="refresh-button" type="button" onclick="loadRoutes()">
            Refresh
        </button>

        <p id="update-status" role="status" aria-live="polite">
            Loading routes...
        </p>
        <p id="filter-status">Showing all routes</p>
        <input type="text" id="route-search" placeholder="Search interface, destination, next hop...">
        <button id="clear-search" type="button">Clear</button>
        <table>
            <thead>
                <tr>
                    <th>
                        <select id="interface-filter">
                            <option value="">All Interfaces</option>
                        </select>
                    </th>
                    <th>
                        Destination
                        <button id="sort-destination" type="button">Sort</button>
                    </th>
                    <th>Next Hop</th>
                    <th>
                        Metric
                        <button id="sort-metric" type="button">Sort</button>
                    </th>
                </tr>
            </thead>
            <tbody id="route-list">

                <% routes.forEach(route=> { %>
                    <tr>
                        <td>
                            <%= route.InterfaceAlias %>
                        </td>
                        <td>
                            <%= route.DestinationPrefix %>
                        </td>
                        <td>
                            <%= route.NextHop %>
                        </td>
                        <td>
                            <%= route.RouteMetric %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
        <script src="/js/routing.js" defer></script>
</body>

</html>