<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NetWall - Interface Assignments</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/sidebar', { activePage: 'interfaces' }) %>

    <main class="content assignment-page">

        <div class="breadcrumb">
            <span>Interfaces</span>
            <span>/</span>
            <span>Interface Assignments</span>
        </div>

        <header class="page-header">
            <h1>Interface Assignments</h1>

            <p>
                Assign physical network ports to logical interfaces.
            </p>
        </header>

        <section class="content-section">

            <div class="section-header">
                <h2>Network Interfaces</h2>
            </div>

            <div class="table-container">

                <table class="assignment-table">

                    <thead>
                        <tr>
                            <th>Interface</th>
                            <th>Description</th>
                            <th>Network Port</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody id="assignment-rows">
                    </tbody>

                </table>

            </div>

            <div class="assignment-actions">

                <button
                    type="button"
                    id="add-button"
                    class="secondary-button">
                    Add Interface
                </button>

                <button
                    type="button"
                    id="save-button"
                    class="primary-button">
                    Save
                </button>

            </div>

            <p id="status" class="status"></p>

        </section>

    </main>

    <script src="/js/assignment.js"></script>

</body>

</html>