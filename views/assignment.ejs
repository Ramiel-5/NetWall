```ejs
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NetWall - Interface Assignments</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/sidebar') %>

    <main class="content assignment-page">

        <header class="breadcrumb">
            <span>Interfaces</span> / Interface Assignments
        </header>

        <h1>Interface Assignments</h1>

        <div class="assignment-table-container">

            <table class="assignment-table">

                <thead>
                    <tr>
                        <th>Interfaces (logical)</th>
                        <th>Network port</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="assignment-rows">
                    <tr>
                        <td colspan="3">Loading interfaces...</td>
                    </tr>
                </tbody>

            </table>

        </div>

        <div class="assignment-bottom-actions">

            <button
                id="add-button"
                class="assignment-add-button"
                type="button">
                + Add
            </button>

            <button
                id="save-button"
                class="assignment-save-button"
                type="button">
                Save
            </button>

        </div>

        <p id="status" role="status" aria-live="polite"></p>

    </main>

    <script src="/js/assignment.js" defer></script>

</body>
</html>
