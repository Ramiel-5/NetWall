<html>

<head>
    <title>Firewall Rules</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/sidebar') %>
        <div class="content">
            <table>
                <thead>
                    <tr>
                        <th>Chain</th>
                        <th>Protocol</th>
                        <th>Action</th>
                        <th>Port</th>
                        <th>Source</th>
                        <th>Destination</th>
                    </tr>
                </thead>
                <tbody>
                    <% rules.forEach(rule=> { %>
                        <tr>
                            <td>
                                <%= rule.chain %>
                            </td>
                            <td>
                                <%= rule.protocol %>
                            </td>
                            <td>
                                <%= rule.action %>
                            </td>
                            <td>
                                <%= rule.port %>
                            </td>
                            <td>
                                <%= rule.source %>
                            </td>
                            <td>
                                <%= rule.destination %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>



</body>

</html>