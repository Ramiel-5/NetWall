<html>

<head>
    <title>Firewall Rules</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/sidebar') %>
        <div class="content">
            <form action="/firewall/add" method="POST">
                <label>Chain</label>
                <select name="chain" required>
                    <option value="INPUT">INPUT</option>
                    <option value="FORWARD">FORWARD</option>
                    <option value="OUTPUT">OUTPUT</option>
                </select>

                <label>Protocol</label>
                <select name="protocol" required>
                    <option value="tcp">TCP</option>
                    <option value="udp">UDP</option>
                    <option value="icmp">ICMP</option>
                    <option value="all">ALL</option>
                </select>

                <label>Action</label>
                <select name="action" required>
                    <option value="ACCEPT">ACCEPT</option>
                    <option value="DROP">DROP</option>
                    <option value="REJECT">REJECT</option>
                </select>

                <label>Port</label>
                <input type="number" name="port" min="1" max="65535" placeholder="Leave empty for any port">

                <label>Source</label>
                <input type="text" name="source" placeholder="e.g. 192.168.1.0/24">

                <label>Destination</label>
                <input type="text" name="destination" placeholder="e.g. 192.168.2.0/24">

                <button type="submit">Add Rule</button>
            </form>

            <table>
                <thead>
                    <tr>

                        <th>Chain</th>
                        <th>Protocol</th>
                        <th>Action</th>
                        <th>Port</th>
                        <th>Source</th>
                        <th>Destination</th>
                        <th>Manage</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (rules.length===0) { %>
                        <tr>
                            <td colspan="8">No firewall rules found.</td>
                        </tr>
                        <% } else %>
                            <% rules.forEach(rule=> { %>
                                <tr>

                                    <td>
                                        <%= rule.chain %>
                                    </td>
                                    <td>
                                        <%= rule.protocol %>
                                    </td>
                                    <td>
                                        <%= rule.action %>
                                    </td>
                                    <td>
                                        <%= rule.port %>
                                    </td>
                                    <td>
                                        <%= rule.source %>
                                    </td>
                                    <td>
                                        <%= rule.destination %>
                                    </td>
                                    <td>
                                        <% if (rule.managed && rule.id) { %>
                                            <form action="/firewall/delete" method="POST">
                                                <input type="hidden" name="id" value="<%= rule.id %>">

                                                <button type="submit" onclick="return confirm('Delete this rule?')">
                                                    Delete
                                                </button>
                                            </form>
                                            <% } else { %>
                                                <span>Not managed</span>
                                                <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                </tbody>
            </table>
        </div>



</body>

</html>